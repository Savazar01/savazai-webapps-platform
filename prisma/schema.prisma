// Prisma Schema for SavazAI WebApps Platform & Cultural Archive
// Configured with PostgreSQL 17, pgvector, RBAC, Dynamic Layouts & Cultural Graph

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuid_ossp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -----------------------------------------------------------------------------
// RBAC & Better-Auth Models
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name               String
  username           String?   @unique
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String?
  role               Role      @default(ADMIN)
  status             String    @default("ACTIVE") // ACTIVE, SUSPENDED
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
  accounts           Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// -----------------------------------------------------------------------------
// Global System Configuration & Storage
// -----------------------------------------------------------------------------

model SystemSetting {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteName          String   @default("SavazAI WebApps — Digital Atelier & Cultural Archive")
  archiveSubtitle   String?  @default("Digital Exhibition & Cultural Suite")
  siteDescription   String?  @db.Text
  adminAlertEmail   String?  @default("alerts@savazar.com")
  contactEmail      String?
  contactPhone      String?

  // Email Notification & Outbound Branding
  emailHeaderTitle    String?  @default("SavazAI WebApps Platform")
  emailHeaderSubtitle String?  @default("Fine Art & Cultural Archive")
  emailLogoUrl        String?
  emailFooterText     String?  @default("Inbound atelier inquiry and archival correspondence.")

  // Admin Login Portal Branding
  adminLoginTitle     String?  @default("SavazAI WebApps Platform Admin")
  adminLoginSubtitle  String?  @default("Sign in with your authorized administrative credentials.")
  adminLoginLogoUrl   String?

  // QR Lead Intake Modal Customization
  qrGateBadgeText     String?  @default("EXHIBITION FLOOR GUIDE")
  qrGateHeaderTitle   String?  @default("Welcome to the Exhibition")
  qrGatePromptText    String?  @default("Enter your details to explore details of the Artwork \"{{artworkName}}\".")
  qrGateButtonLabel   String?  @default("Unlock Masterwork Details")
  qrGateAllowSkip     Boolean  @default(true)

  // Watermark parameters
  watermarkText     String   @default("© SavazAI WebApps | All Rights Reserved")
  watermarkOpacity  Float    @default(0.4)
  watermarkFontSize Int      @default(32)
  watermarkStyle    String?  @default("REPEAT_DIAGONAL") // REPEAT_DIAGONAL, BANNER, CORNER, BOTH

  // Cloudflare R2 / AWS S3 storage settings
  storageProvider   String   @default("LOCAL") // LOCAL, R2, S3
  r2AccountId       String?
  r2BucketName      String?
  r2PublicUrl       String?
  s3Region          String?  @default("ap-south-1")
  s3BucketName      String?
  s3Endpoint        String?
  s3AccessKey       String?
  s3SecretKey       String?
  s3PublicUrl       String?
  
  // Localization defaults
  defaultCurrency   String   @default("INR")
  defaultTimezone   String   @default("Asia/Kolkata")

  instagramUrl      String?
  youtubeUrl        String?
  facebookUrl       String?
  pinterestUrl      String?
  linkedinUrl       String?
  tiktokUrl         String?
  customSocialLinks Json?    // [{ label: string, url: string, icon: string }]
  // Branding
  logoUrl           String?
  faviconUrl        String?

  // Archival Provenance & Copyright Notice for Artwork Pages
  copyrightNoticeHeader  String?  @default("Archival Provenance & Copyright Notice")
  copyrightNoticeContent String?  @db.Text

  // Dynamic Footer, Email/Gmail SMTP & Multi-Provider AI Configuration
  footerConfig      Json?
  emailConfig       Json?
  aiConfig          Json?
  adminConfig       Json?
  themeConfig       Json?   // Public design token overrides: { light: { "--background": "#...", ... }, dark: { ... } }
  watermarkConfig   Json?   // Watermark & Foil Earmarks config: { text?: string, position?: string, opacity?: number, defaultFoilEarmarkText?: string, showFoilEarmark?: boolean }
  googleServicesConfig Json? // Google Workspace { enabled: boolean, clientId: string, clientSecret: string, refreshToken: string, driveFolderId: string, sheetId: string, defaultServices: string[] }
  nextcloudConfig      Json? // Nextcloud WebDAV { enabled: boolean, serverUrl: string, username: string, appPassword: string, baseFolder: string }
  formSecurityConfig   Json? // Form Security & Anti-Spam { contactForm: { enableCaptcha: boolean, enableEmailOtp: boolean }, qrScanGate: { enableCaptcha: boolean, enableEmailOtp: boolean } }

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("system_settings")
}

// -----------------------------------------------------------------------------
// Dynamic Navigation (Menu Items)
// -----------------------------------------------------------------------------

enum MenuPosition {
  TOP_LEFT
  TOP_CENTER
  TOP_RIGHT
  SIDEBAR_LEFT
  DRAWER_RIGHT
}

model MenuItem {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  label        String
  path         String
  position     MenuPosition  @default(TOP_CENTER)
  orderIndex   Int           @default(0)
  isActive     Boolean       @default(true)
  openInNewTab Boolean       @default(false)
  iconName     String?

  // Self-referencing hierarchy supporting up to 2 nested sub-menu tiers
  parentId     String?       @db.Uuid
  parent       MenuItem?     @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]    @relation("MenuHierarchy")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("menu_items")
}

// -----------------------------------------------------------------------------
// Dynamic Page Layout Engine (12-Column Responsive Grid)
// -----------------------------------------------------------------------------

model Page {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title           String
  slug            String        @unique
  metaDescription String?       @db.Text
  isPublished     Boolean       @default(false)
  publishedAt     DateTime?
  isActive        Boolean       @default(true)
  isDeleted       Boolean       @default(false)
  showOnHomepage  Boolean       @default(false)
  sortOrder       Int           @default(0)
  pageType        String        @default("STANDARD") // "STANDARD" | "LANDING_PAGE"
  isHomepage      Boolean       @default(false)
  archetype       String?       @default("BLANK")
  eyebrowTag      String?
  heroTitle       String?
  heroSubtitle    String?       @db.Text
  config          Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sections        PageSection[]

  @@index([sortOrder])
  @@index([isActive, isDeleted])
  @@map("pages")
}

model PageSection {
  id                       String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pageId                   String        @db.Uuid
  title                    String?
  subtitle                 String?
  description              String?
  titleAlignment           String?       @default("center") // "left" | "center" | "right"
  slug                     String?
  orderIndex               Int           @default(0)
  gridSpan                 Int           @default(12) // 1 to 12 responsive grid span
  backgroundColor          String?
  backgroundType           String?       @default("COLOR") // COLOR, PATTERN, IMAGE
  backgroundPattern        String?
  backgroundImage          String?
  backgroundOverlayOpacity  Float?        @default(0.5)
  customCssClass           String?
  layoutType               String?       @default("PRESET") // "PRESET" | "MATRIX"
  matrixConfig             Json?         // Stores MatrixSectionConfig
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  page                     Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  subSections              SubSection[]

  @@map("page_sections")
}

model SubSection {
  id                       String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sectionId                String      @db.Uuid
  title                    String?
  orderIndex               Int         @default(0)
  gridSpan                 Int         @default(12) // 1 to 12 responsive grid span
  content                  Json        // Rich block JSON content
  backgroundType           String?     @default("COLOR") // COLOR, PATTERN, IMAGE
  backgroundPattern        String?
  backgroundImage          String?
  backgroundOverlayOpacity  Float?      @default(0.5)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  section                  PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("sub_sections")
}

// -----------------------------------------------------------------------------
// Artwork Catalog, Categories & Exhibitions
// -----------------------------------------------------------------------------

model ArtCategory {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String    @unique // Tanjore, Mysore, Pahari, Pichwai, Kalamkari, Cheriyal, Miscellaneous
  slug           String    @unique
  description    String?   @db.Text
  coverImage     String?
  displayOrder   Int       @default(0)

  // Configurable Hero Banner Elements
  badgeLabel     String?   @default("Traditional Fine Art School")
  heroTitle      String?   // Defaults to category name if null
  curatorialNote String?   @db.Text // Rich Tiptap HTML content

  // Banner Styling Configurations
  bannerHeight   Int?      @default(360) // in pixels
  overlayOpacity Float?    @default(0.45) // 0.0 to 1.0
  imagePosition  String?   @default("center") // "center" | "top" | "bottom"
  borderStyle    String?   @default("gold-fillet") // "none" | "gold-fillet" | "subtle"

  // Self-referencing Parent-Child relationship
  parentId       String?       @db.Uuid
  parent         ArtCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       ArtCategory[] @relation("CategoryHierarchy")

  isActive       Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  showOnHomepage Boolean   @default(false)
  sortOrder      Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  artworks       Artwork[]

  @@index([sortOrder])
  @@index([isActive, isDeleted])
  @@map("art_categories")
}

model Artwork {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  slug               String               @unique
  description        String               @db.Text
  categoryId         String               @db.Uuid
  dimensions         String               // e.g. "36 x 48 inches"
  medium             String               // Legacy field preserved for backward compatibility
  materials          String?              // e.g. "Natural pigments, shell gold, semi-precious stones"
  surface            String?              // e.g. "Wasli paper, teakwood plank, silk, khadi cloth"
  yearCreated        Int
  hasGoldFoil        Boolean              @default(false)
  goldPurity         String?              // e.g. "22 Carat Jaipur Gold Leaf"
  customFoilLabel    String?              // Optional override for foil earmark (e.g. "Pure 22K Jaipur Gold Leaf")
  price              Decimal?             @db.Decimal(12, 2)
  currency           String               @default("INR")
  isAvailable        Boolean              @default(true)
  isFeatured         Boolean              @default(false)
  isActive           Boolean              @default(true)
  isDeleted          Boolean              @default(false)
  showOnHomepage     Boolean              @default(false)
  sortOrder          Int                  @default(0)
  primaryImageUrl    String
  watermarkedWebpUrl String
  originalFileName   String?              // Authentic uploaded client file name
  protectedS3Key     String?              // Protected original master S3 key
  qrCodeUrl          String?              // Generated high-res Exhibition Floor QR code URL
  watermarkOverride  Boolean              @default(false)
  customWatermark    Json?
  
  // 1536-dimensional embedding for pgvector visual similarity
  embedding          Unsupported("vector(1536)")?

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  category           ArtCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events             ArtworkOnEvent[]
  leads              Lead[]               @relation("ArtworkLeads")
  directLeads        Lead[]               @relation("DirectArtworkLeads")
  ragaLinks          ArtworkRagaLink[]
  eCatalogItems      ECatalogItem[]

  @@index([sortOrder])
  @@index([isActive, isDeleted])
  @@map("artworks")
}

model ArtworkOnEvent {
  artworkId    String   @db.Uuid
  eventId      String   @db.Uuid
  displayOrder Int      @default(0)

  artwork      Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([artworkId, eventId])
  @@map("artworks_on_events")
}

// -----------------------------------------------------------------------------
// Indian Classical Music Synesthesia Graph
// -----------------------------------------------------------------------------

model Raga {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String            @unique
  melakartaNumber Int?
  arohana         String            // Ascending scale (e.g. S R₂ G₃ M₁ P D₂ N₃ Ṡ)
  avarohana       String            // Descending scale
  deity           String?
  rasa            String?           // Bhakti, Shanta, Karuna, etc.
  timeOfDay       String?
  description     String?           @db.Text
  embedding       Unsupported("vector(1536)")?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  compositions    Composition[]
  artworkLinks    ArtworkRagaLink[]

  @@map("ragas")
}

model Composition {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  ragaId      String    @db.Uuid
  tala        String    // Adi, Rupaka, etc.
  composer    String    // Tyagaraja, Dikshitar, etc.
  vocalist    String    @default("Atelier Master")
  audioUrl    String
  lyrics      String?   @db.Text
  translation String?   @db.Text
  duration    Int       // seconds
  recordedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  raga        Raga      @relation(fields: [ragaId], references: [id], onDelete: Cascade)

  @@map("compositions")
}

model ArtworkRagaLink {
  artworkId   String   @db.Uuid
  ragaId      String   @db.Uuid
  harmonyNote String?  @db.Text
  createdAt   DateTime @default(now())

  artwork     Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  raga        Raga     @relation(fields: [ragaId], references: [id], onDelete: Cascade)

  @@id([artworkId, ragaId])
  @@map("artwork_raga_links")
}

// -----------------------------------------------------------------------------
// Events, Workshops, Exhibitions & Concerts
// -----------------------------------------------------------------------------

enum EventType {
  WORKSHOP
  ONLINE_CLASSROOM
  EXHIBITION
  CONCERT
  RECITAL
  PRIVATE_VIEWING
  OTHER
}

model Event {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  slug               String              @unique
  earmarkText        String?             @default("Curated Exhibition & Recital")
  eventType          EventType
  description        String              @db.Text
  venue              String
  venueName          String?
  streetAddress      String?
  city               String
  stateProvince      String?
  postalCode         String?
  country            String              @default("India")
  countryCode        String?
  timezone           String              @default("Asia/Kolkata")
  startDate          DateTime
  endDate            DateTime?
  posterUrl          String?
  bannerImage        String?
  galleryImages      Json?
  brochurePdfUrl        String?
  brochureTitle         String?             @default("Exhibition Monograph & Program Brochure")
  brochureDownloadable  Boolean             @default(true)
  galleryDisplayMode    String?             @default("CAROUSEL") // "CAROUSEL" | "SCROLL" | "COLLAGE"
  galleryAutoplayTimer  Int?                @default(4)
  maxCapacity        Int?
  registrationFee    Decimal?            @db.Decimal(10, 2)
  currency           String              @default("INR")
  isRegistrationOpen Boolean             @default(true)
  isPublished        Boolean             @default(true)
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  statusOverride     String?             @default("AUTO") // "AUTO" | "FORCE_UPCOMING" | "FORCE_PAST"
  isArchived         Boolean             @default(false)
  isActive           Boolean             @default(true)
  isDeleted          Boolean             @default(false)
  showOnHomepage     Boolean             @default(false)
  sortOrder          Int                 @default(0)
  rsvpConfig         Json?               // Dynamic RSVP Form Builder Settings (EventRsvpConfig)
  dailySchedules     Json?               // Multi-Day Daily Schedules ({ date: string, startTime: string, endTime: string, label?: string }[])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  artworks           ArtworkOnEvent[]
  registrations      EventRegistration[]
  leads              Lead[]
  eCatalogs          ECatalog[]

  @@index([sortOrder])
  @@index([isActive, isDeleted])
  @@map("events")
}

model EventRegistration {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId       String   @db.Uuid
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  ticketCount   Int      @default(1)
  paymentStatus String   @default("CONFIRMED")
  selectedDate  String?
  selectedSlot  String?
  registeredAt  DateTime @default(now())

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_registrations")
}

// -----------------------------------------------------------------------------
// Inbound Leads CRM (Web Forms & Physical QR Scans)
// -----------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  QUALIFIED
  CLOSED
  ARCHIVED
}

enum LeadSource {
  CONTACT_FORM
  EVENT_RSVP
  QR_SCAN
  CUSTOM_FORM
}

model Lead {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  email           String?
  phone           String?
  source          LeadSource  @default(CONTACT_FORM)
  subject         String?
  message         String?     @db.Text
  status          LeadStatus  @default(NEW)
  formTitle       String?     // e.g. "General Contact", "Private Viewing RSVP", "Commission Request"
  pageSlug        String?     // e.g. "contact", "about-me", "home"
  artworkId       String?     @db.Uuid
  artworkTitle    String?
  deviceInfo      String?
  isSubscribed    Boolean     @default(true)
  isEmailVerified Boolean     @default(false)
  verifiedAt      DateTime?
  lastVerifiedIp  String?
  customFields    Json?       // Key-value store of dynamic fields
  sourceArtworkId String?     @db.Uuid // Linked artwork for physical exhibition QR scans or direct inquiries
  sourceEventId   String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  artwork         Artwork?    @relation("DirectArtworkLeads", fields: [artworkId], references: [id], onDelete: SetNull)
  sourceArtwork   Artwork?    @relation("ArtworkLeads", fields: [sourceArtworkId], references: [id], onDelete: SetNull)
  sourceEvent     Event?      @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model UnsubscribedContact {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@map("unsubscribed_contacts")
}

// -----------------------------------------------------------------------------
// Form Security & Email OTP Verification Tokens
// -----------------------------------------------------------------------------

model FormVerificationToken {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email       String
  codeHash    String    // SHA-256 HMAC of 6-digit OTP
  formType    String    // "CONTACT", "EVENT_RSVP", "QR_SCAN", "CUSTOM_PAGE"
  targetId    String?   // eventId, artworkId, or customFormId
  attempts    Int       @default(0)
  isUsed      Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([email, formType])
  @@map("form_verification_tokens")
}

// -----------------------------------------------------------------------------
// SEO / AEO Optimized Blog Posts
// -----------------------------------------------------------------------------

model BlogPost {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title            String
  slug             String    @unique
  excerpt          String    @db.Text
  content          String    @db.Text
  featuredImageUrl String?
  author           String    @default("Curatorial Team")
  tags             String[]
  metaTitle        String?
  metaDescription  String?
  structuredJsonLd Json?     // Structured Schema.org Article / BreadcrumbList JSON-LD
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("blog_posts")
}

// -----------------------------------------------------------------------------
// Customizable Admin Dashboard Widgets
// -----------------------------------------------------------------------------

model DashboardWidget {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title          String
  description    String?
  widgetType     String   // "STAT_CARD", "QUICK_LINK", "SYSTEM_STATUS", "CUSTOM_HTML"
  metricValue    String?
  metricSub      String?
  targetUrl      String?
  iconName       String?  // Lucide icon identifier
  metricSource   String?  @default("static:manual")
  metricFilterId String?
  order          Int      @default(0)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("dashboard_widgets")
}

// -----------------------------------------------------------------------------
// Digital Exhibition e-Catalogs & Booklets
// -----------------------------------------------------------------------------

model ECatalog {
  id                 String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  slug               String         @unique
  subtitle           String?
  curatorNote        String?        @db.Text
  curatorialEssay    String?        @db.Text
  forewordBy         String?
  coverImage         String?
  coverImageUrl      String?
  pdfUrl             String?        // Optional pre-compiled static PDF asset
  downloadablePdfUrl String?
  themeColor         String         @default("gold")
  orientation        String         @default("portrait") // "portrait" | "landscape"
  pageSize           String?        @default("A4") // "A4" | "A3" | "A5" | "LETTER" | "TABLOID" | "SQUARE"
  plateLayout        String         @default("SIDE_BY_SIDE") // "SIDE_BY_SIDE" | "STACKED" | "TOP_LEFT_FLOW"
  plateRatio         String?        @default("55:45") // "40:60" | "45:55" | "50:50" | "55:45" | "60:40"

  // Global Catalog Theme & Framing
  // { backgroundColor, textColor, frameStyle: "none"|"gold-fillet"|"double-fillet"|"silk-border", accentColor }
  themeConfig        Json?

  // Page-Specific Customizations
  // { backgroundColor, backgroundImage, frameStyle, showDate, showCurator, subtitle }
  coverConfig        Json?
  // { title, contentHtml, backgroundImage, backgroundColor, frameStyle }
  essayConfig        Json?
  curatorialConfig   Json?
  magazineConfig     Json?
  // { isEnabled: boolean, title, contentHtml, backgroundImage, backgroundColor, frameStyle, contactDetails }
  endPageConfig      Json?

  // Linked Event / Exhibition (Optional)
  eventId            String?        @db.Uuid
  event              Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Custom Introductory Sections (Cover, Preface, Artist Bio, Colophon)
  // Stored as JSON array: [{ id: string, title: string, contentHtml: string, orderIndex: number }]
  introSections      Json?

  // Custom Editorial & Magazine Pages
  customPages        ECatalogCustomPage[]

  // Curated Artworks Selection
  items              ECatalogItem[]

  isPublished        Boolean        @default(false)
  isActive           Boolean        @default(true)
  isDeleted          Boolean        @default(false)
  showOnHomepage     Boolean        @default(false)
  sortOrder          Int            @default(0)
  downloadEnabled    Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([sortOrder])
  @@index([isActive, isDeleted])
  @@map("e_catalogs")
}

model ECatalogCustomPage {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  catalogId         String    @db.Uuid
  catalog           ECatalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  pageNumber        Int       @default(1)
  title             String?   // e.g. "Sacred Iconography & Nayaka Influence"
  subtitle          String?   // e.g. "Scholarly commentary and dynastic patronage"
  layoutType        String    @default("2_COL") // "1_COL" | "2_COL" | "3_COL" | "4_COL" | "6_COL" | "ASYMMETRIC_70_30" | "ASYMMETRIC_30_70"
  pageLayout        String?   @default("2_COL") // backward compatible alias
  contentHtml       String?   @db.Text
  sections          Json?     // Optional structured blocks
  segments          Json?     // Array of segment objects: [{ id, title, contentHtml, image, caption, widthRatio }]

  // Matrix & Layout Definition
  matrixRows        Int       @default(2)
  matrixCols        Int       @default(2)
  rowHeights        String?   @default("1fr 1fr")
  colWidths         String?   @default("1fr 1fr")
  hasHeader         Boolean   @default(false)
  headerHtml        String?   @db.Text
  hasFooter         Boolean   @default(false)
  footerHtml        String?   @db.Text
  verticalSpineMode String    @default("NONE") // "NONE" | "LEFT" | "RIGHT"
  verticalSpineHtml String?   @db.Text
  verticalSpineWidth String?  @default("25%")

  // Background Styling Suite
  backgroundType    String    @default("COLOR") // "COLOR" | "PATTERN" | "IMAGE"
  backgroundColor   String?   @default("#FAF7F2")
  backgroundPattern String?
  patternOpacity    Float?    @default(0.15)
  backgroundImage   String?
  overlayOpacity    Float?    @default(0.2)
  frameStyle        String?   @default("gold-fillet")

  // Unified Page Config (Single Plate, WYSIWYG, Matrix, Framing)
  pageConfig        Json?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("e_catalog_custom_pages")
}

model ECatalogTemplate {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  description        String?
  targetPageType     String    @default("MAGAZINE") // "COVER" | "MAGAZINE" | "END_PAGE"
  matrixRows         Int       @default(2)
  matrixCols         Int       @default(2)
  rowHeights         String?   @default("1fr 1fr")
  colWidths          String?   @default("1fr 1fr")
  hasHeader          Boolean   @default(false)
  headerHtml         String?   @db.Text
  hasFooter          Boolean   @default(false)
  footerHtml         String?   @db.Text
  verticalSpineMode  String    @default("NONE") // "NONE" | "LEFT" | "RIGHT"
  verticalSpineHtml  String?   @db.Text
  verticalSpineWidth String?   @default("25%")
  segments           Json?     // Skeleton matrix segments [{ row, col, rowSpan, colSpan, title, contentHtml }]
  frameStyle         String?   @default("gold-fillet")
  backgroundType     String?   @default("COLOR")
  backgroundColor    String?   @default("#FAF7F2")
  backgroundPattern  String?
  patternOpacity     Float?    @default(0.15)
  backgroundImage    String?
  overlayOpacity     Float?    @default(0.2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("e_catalog_templates")
}

model ECatalogItem {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  catalogId      String   @db.Uuid
  catalog        ECatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  artworkId      String   @db.Uuid
  artwork        Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  orderIndex     Int      @default(0)
  pageNumber     Int      @default(1)
  customNote     String?  @db.Text
  curatorialNote String?  @db.Text
  highlightPlate Boolean  @default(false)
  plateLayout    String?  // Optional per-plate override: "SIDE_BY_SIDE" | "STACKED" | "TOP_LEFT_FLOW"
  plateRatio     String?  // Optional per-plate ratio override: "40:60" | "45:55" | "50:50" | "55:45" | "60:40"
  customTitle    String?  // Custom page heading (defaults to artwork title)
  customSubtitle String?  // Custom subheading/tagline (defaults to category/school)
  showPlateNumber Boolean @default(true) // Toggle for "Plate X of Y" badge

  @@unique([catalogId, artworkId])
  @@map("e_catalog_items")
}

// -----------------------------------------------------------------------------
// Email Template Configuration & Outbound Dispatch Audit Engine
// -----------------------------------------------------------------------------

model EmailTemplateConfig {
  id                String   @id @default(cuid())
  triggerType       String   @unique // "contact", "event_rsvp", "acquisition", "custom_form"
  name              String
  adminSubject      String
  adminBodyTemplate String   @db.Text
  sendUserReceipt   Boolean  @default(true)
  userSubject       String?
  userBodyTemplate  String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("email_template_configs")
}

model EmailDispatchLog {
  id           String   @id @default(cuid())
  recipient    String
  sender       String
  triggerType  String
  subject      String
  status       String   // "SENT", "FAILED"
  errorMessage String?
  createdAt    DateTime @default(now())

  @@map("email_dispatch_logs")
}

